---
/**
 * /teaching: can Andrew teach a room, and how does he go about it?
 * The first screen is the proof: a running head, the claim, and 55 seconds of him
 * teaching (DojoClip), with a link under it to the other recording on the site, his
 * walkthrough of the rap's prompts. Then Claude Dojo (run of show and belt ladder render from
 * src/data/dojo.json), the four labs a visitor can take now (Lab 01 on the home page
 * plus the lessons collection), how he teaches, and talks and workshops.
 *
 * The run of show says what happened on each day, so no paragraph retells it. The scope
 * sentence under How I teach comes from dojo.json `said`, so this page and the case study
 * use the same words. Their sources are the recordings index and Andrew's slot script,
 * never the planning document. The Lab 01 teaser asks the question and leaves the answer
 * to the lab.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Overprint from '../../components/Overprint.astro';
import RunHead from '../../components/RunHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import DojoClip from '../../components/figures/DojoClip.astro';
import RunOfShow from '../../components/teaching/RunOfShow.astro';
import Ladder from '../../components/teaching/Ladder.astro';
import LabSet, { type Lab } from '../../components/teaching/LabSet.astro';
import dojo from '../../data/dojo.json';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

// Which drawing each lab shows of itself (see LabSet).
const SKETCH: Record<string, Lab['sketch']> = { 'agent-loop': 'loop', connect: 'mcp', 'fifteen-terms': 'rap' };
const labs: Lab[] = [
  {
    title: 'Who runs the tool?',
    // The question only: the answer is the lab's to give, after the guess.
    idea: 'Tick the model or your code, then see which one does.',
    minutes: 1,
    href: '/',
    where: 'on the home page',
    sketch: 'tool' as const,
  },
  ...lessons.map((l) => ({
    title: l.data.title,
    idea: l.data.idea,
    minutes: l.data.minutes,
    href: `/teaching/${l.id}`,
    sketch: SKETCH[l.id] ?? ('tool' as const),
  })),
].map((l, i) => ({ ...l, n: i + 1 }));

const r = dojo.record;
const s = dojo.said;
const essay = 'https://www.linkedin.com/pulse/lecun-studied-llms-i-cs-lewis-both-learned-limits-language-andrew-yu-kogmc';
---

<Base
  title="Teaching"
  description="Andrew Yu teaches people to build with Claude Code: 103 people through Claude Dojo with other instructors, about 70 of them in one two-day hands-on intensive, plus four labs on this site you can take now."
>
  <div class="top">
    <RunHead left="Teaching" right="Claude Dojo, July 2026" />
    <header class="intro">
      <div class="intro__words">
        <Overprint as="h1" text="I teach people to build with Claude Code." />
        <p class="lede">
          Mostly in live rooms where some people write code and most do not. The rest happens in labs on this site that
          you can take on your own.
        </p>
      </div>
      <div class="intro__proof">
        <DojoClip class="intro__clip" />
        <p class="intro__also">
          <a class="more" href="/teaching/fifteen-terms#walkthrough"
            >Watch me walk the room through the prompts behind a rap, 2&nbsp;minutes&nbsp;54&nbsp;seconds</a
          >
        </p>
      </div>
    </header>
  </div>

  <section class="sec" id="claude-dojo" aria-labelledby="dojo-h">
    <SectionHead title="Claude Dojo" id="dojo-h">A nonprofit where I am Director of AI Enablement. It is independent of Anthropic.</SectionHead>

    <div class="tally">
      <ul class="tally__band" aria-label="Claude Dojo on record">
        <li>
          <span class="numeral">{r.people}</span>
          <span>people I taught to build with Claude Code, with the other instructors</span>
        </li>
        <li>
          <span class="numeral"><small>about</small>{r.intensive}</span>
          <span>of them in one two-day hands-on intensive, {r.dates}</span>
        </li>
        <li>
          <span class="numeral">{r.lessons}</span>
          <span>lessons in the curriculum I co-authored</span>
        </li>
        <li>
          <span class="numeral">{r.videos}</span>
          <span>lesson videos to go with them</span>
        </li>
      </ul>
      <a class="more" href="/work/claude-dojo">Read the Claude Dojo case study</a>
    </div>

    <div class="sub" id="intensive">
      <h3 class="title sub__title">The two days</h3>
      <RunOfShow />
    </div>

    <div class="sub" id="curriculum">
      <div class="split sub__head">
        <h3 class="title">The curriculum</h3>
        <p>
          A ladder from what an LLM is to a shipped capstone. The top rung asks for a working tool anyone can open, plus a {
            dojo.capstone.words
          } word write-up or a {dojo.capstone.video} demo video.
        </p>
      </div>
      <Ladder counts={false} />
    </div>

    <div class="sub" id="rap">
      <div class="split sub__head">
        <h3 class="title">The fifteen terms, as a rap</h3>
        <div>
          <p>
            Fifteen new terms are hard to keep in your head on your first day with a new tool. So I made a rap with Claude that
            counts off the Claude Code terms a beginner meets first, in the order they meet them. We played it for the room
            on Day 1 of the intensive.
          </p>
          <a class="more rap__more" href="/teaching/fifteen-terms">Play it with the lyric sheet</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="labs" aria-labelledby="labs-h">
    <SectionHead title="Take a lab" id="labs-h">Each one teaches one idea, and you can finish it on this site.</SectionHead>
    <LabSet labs={labs} />
  </section>

  <section class="sec" id="method" aria-labelledby="method-h">
    <SectionHead title="How I teach" id="method-h">Each habit links to the place you can check it.</SectionHead>

    <div class="practice">
      <h3 class="title">One misconception, and a guess first</h3>
      <div>
        <p>
          Lab 01 goes after a single wrong idea: that the model runs its own tools. Before it explains anything, it asks
          you to tick a box and commit to an answer, so the explanation lands on a guess you already made.
        </p>
        <a class="more" href="/">Try Lab 01</a>
      </div>
    </div>

    <div class="practice">
      <h3 class="title">Say what to do when it fails</h3>
      <div>
        <p>
          The wrong answer in Lab 01 gets its own paragraph, which tells you what to try next. The Dojo Skill build planned
          for a first run that comes out partly wrong. The plan was for people to tell Claude what was wrong and run it again,
          because that loop is what they take home.
        </p>
        <a class="more" href="/">See the failure path in Lab 01</a>
      </div>
    </div>

    <div class="practice">
      <h3 class="title">Leave with something that runs</h3>
      <div>
        <p>
          At the intensive the work was hands-on, on each person’s own laptop. The people who were job searching built a
          resume-tailoring Skill with me, and that evening people started a capstone on mock data. The top rung’s standard
          rules out screenshots and slides. It has to work when someone else clicks the link.
        </p>
        <a class="more" href="#intensive">See the two days</a>
      </div>
    </div>

    <div class="practice">
      <h3 class="title">Cut scope for a first room</h3>
      <div>
        <p>
          For about {r.intensive} people of mixed skill, one agent was enough. {s.agents} Anyone who raced ahead had the
          rest of the ladder to climb on their own.
        </p>
        <a class="more" href="#curriculum">See the ladder</a>
      </div>
    </div>
  </section>

  <section class="sec" id="rooms" aria-labelledby="rooms-h">
    <SectionHead title="Talks and workshops" id="rooms-h">Where else I have stood in front of people and taught.</SectionHead>
    <div class="rooms-set">
    <div class="workshop spot">
      <p class="field">Workshop</p>
      <p class="workshop__name">Mental Models for Decision Making</p>
      <p>
        I gave my workshop, Mental Models for Decision Making, to more than 200 attendees at the All-Team Training
        Retreat in July 2024. The Dojo
        curriculum puts a rung on mental models before anyone touches a tool.
      </p>
    </div>
    <ul class="rooms">
      <li>
        <p class="title">Lightning talks</p>
        <div>
          <p>
            I gave a lightning talk at Splunk in 2022 and give lightning talks at Salesforce now. The Splunk talk, “The
            Limitations of Language,” later grew into an essay.
          </p>
          <a class="more" href={essay}>Read the essay</a>
        </div>
      </li>
      <li>
        <p class="title">Salesforce</p>
        <p>
          I teach AI to my coworkers. I am Lead Technical Writer there, on a three-person team that ships quickstarts,
          starter kits, agent skills, and demos for developers.
        </p>
      </li>
      <li>
        <p class="title">Ministry</p>
        <p>For years I have taught live rooms as a minister.</p>
      </li>
    </ul>
    </div>
  </section>
</Base>

<style>
  .top {
    padding-top: clamp(20px, 3vw, 36px);
  }
  /* The claim on the left, the proof beside it, top-aligned. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 4.5fr) minmax(0, 5.5fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-top: clamp(32px, 4.4vw, 60px);
  }
  .intro :global(h1) {
    font-size: clamp(2.875rem, 5.9vw, 5.5rem);
    max-width: 11ch;
  }
  .intro .lede {
    margin-top: clamp(18px, 2.2vw, 28px);
    max-width: 30ch;
  }
  .intro :global(.intro__clip) {
    margin-top: 6px;
  }
  .intro :global(.intro__clip figcaption) {
    font-size: 0.8125rem;
  }
  /* The second recording on the site, under the first one's caption. */
  .intro__also {
    margin-top: 14px;
    text-wrap: balance;
  }

  .rap__more {
    margin-top: 12px;
  }

  /* The record, printed on one flat band of teal with the type knocked out. */
  .tally {
    padding-top: 30px;
  }
  .tally__band {
    list-style: none;
    margin: 0;
    padding: clamp(22px, 3vw, 34px) clamp(18px, 2.4vw, 30px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px clamp(18px, 2.4vw, 30px);
    background: var(--band, var(--ink));
    color: var(--band-text, var(--stock));
  }
  .tally__band li {
    display: grid;
    align-content: start;
    gap: 10px;
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.4;
  }
  .tally__band li + li {
    border-left: 1.5px solid currentColor;
    padding-left: clamp(18px, 2.4vw, 30px);
  }
  .tally__band .numeral {
    font-size: clamp(3.25rem, 6.4vw, 5.5rem);
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .tally__band small {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tally > .more {
    margin-top: 16px;
  }

  /* The page grid: label column, content column. */
  .split {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
  }

  .sub {
    margin-top: clamp(56px, 7vw, 88px);
  }
  /* A sub-head stays in the label column, two lines at most, with its sentence beside the
     first line. */
  .sub__head {
    align-items: start;
    padding-bottom: 18px;
  }
  .sub__head .title,
  .sub__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .sub__head .title {
    padding-top: 2px;
  }
  .sub__head p {
    max-width: 60ch;
    color: var(--text-soft);
  }
  /* The run sheet says what happened on each day, so its title needs no sentence beside it. */
  .sub__title {
    padding-bottom: 28px;
  }
  #curriculum .sub__head {
    padding-bottom: 28px;
  }

  /* How I teach */
  .practice {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
    padding: 28px 0 30px;
    border-bottom: var(--rule-dash);
  }
  .practice:last-child {
    border-bottom: 0;
  }
  .practice .title {
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
  }
  .practice p {
    max-width: 62ch;
  }
  .practice p + .more {
    margin-top: 12px;
  }

  /* Other rooms: the workshop on a field of pink, the rest of the rooms beside it. */
  .rooms-set {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-top: 30px;
  }
  .workshop {
    display: grid;
    gap: 10px;
    padding: clamp(22px, 3vw, 36px);
  }
  .workshop .field {
    margin: 0;
  }
  .workshop__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 0.98;
    max-width: 16ch;
  }
  .workshop__n {
    display: flex;
    align-items: flex-start;
    margin: 6px 0 4px;
  }
  .workshop__n .numeral {
    font-size: clamp(5rem, 10vw, 8.5rem);
  }
  .workshop__plus {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: var(--w-shout);
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    line-height: 1;
  }
  .workshop p:last-child {
    max-width: 44ch;
  }
  .rooms {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule);
  }
  .rooms li {
    display: grid;
    gap: 8px;
    padding: 20px 0 22px;
    border-bottom: var(--rule-dash);
  }
  .rooms li:last-child {
    border-bottom: 0;
  }
  .rooms .title {
    font-size: 1.3125rem;
  }
  .rooms p:not(.title) {
    max-width: 62ch;
  }
  .rooms .more {
    margin-top: 10px;
  }

  @media (max-width: 860px) {
    /* Proof before prose: on one column the clip comes straight after the claim. */
    .intro {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .intro__words {
      display: contents;
    }
    .intro__proof {
      order: 2;
    }
    .intro :global(.intro__clip) {
      margin-top: 24px;
    }
    .intro .lede {
      order: 3;
      max-width: 40ch;
    }
  }
  @media (max-width: 600px) {
    .split,
    .practice {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .tally__band li + li {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 860px) {
    .tally__band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tally__band li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .rooms-set {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
