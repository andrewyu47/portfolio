---
/**
 * /path: how an English major came to teach AI and build the labs.
 * The first screen draws the whole path once (PathChart). The sections under it are set
 * so the record reads as one ledger: roles with their result at the right; teaching led by
 * the intensive as one full-width row, then the rest as rows in the same grammar as roles;
 * builds one line each. Education closes the page as a single line.
 * Everything renders from src/data/timeline.json, which the site index and the MCP server also read.
 */
import Base from '../layouts/Base.astro';
import RunHead from '../components/RunHead.astro';
import Overprint from '../components/Overprint.astro';
import SectionHead from '../components/SectionHead.astro';
import Stamp from '../components/Stamp.astro';
import RecordRows, { type Entry } from '../components/path/RecordRows.astro';
import PathChart from '../components/path/PathChart.astro';
import timeline from '../data/timeline.json';

const all = timeline as Entry[];
const of = (kind: string) => all.filter((e) => e.kind === kind);
const teaching = of('teaching');
const feature = teaching.find((e) => e.feature)!;
const ledger = teaching.filter((e) => !e.feature);
const builds = of('build');
const checked = builds.filter((b) => b.href && /^https?:/.test(b.href)).length;
const degree = of('education')[0];
const courses = of('certification').map((c) => c.title);
---

<Base
  title="Path"
  description="Andrew Yu studied English at UC Berkeley and has worked in software since 2015, most of that time writing documentation. He now teaches AI and builds with Claude Code."
>
  <RunHead left="Path" right="2012 to 2026" />

  <header class="head">
    <div class="head__claim">
      <Overprint as="h1" text={'I studied English.\nNow I teach AI\nand build the labs.'} />
      <p class="head__lede">
        I have worked in software since 2015, most of that time writing documentation.
      </p>
    </div>
    <div class="head__spot spot">
      <p class="head__n">103</p>
      <p class="head__what">people I have taught to build with Claude Code, with the other instructors at Claude Dojo.</p>
      <a class="more" href="/work/claude-dojo">Read about Claude Dojo</a>
    </div>
  </header>

  <div class="chart">
    <PathChart />
  </div>

  <section class="sec" id="work" aria-labelledby="work-h">
    <SectionHead title="Work" id="work-h" />
    <RecordRows entries={of('role')} label="Roles, most recent first" />
  </section>

  <section class="sec" id="teaching" aria-labelledby="teaching-h">
    <SectionHead title="Teaching" id="teaching-h" />
    <article class="feat" aria-labelledby="feat-h">
      <p class="feat__when">Jul 11 and 12, 2026</p>
      <div class="feat__main">
        <figure class="feat__fig" data-print>
          <p class="feat__n">{feature.figure?.value}</p>
          <span class="feat__ink plate" aria-hidden="true"></span>
          <figcaption class="feat__cap">{feature.figure?.caption}</figcaption>
        </figure>
        <div class="feat__body">
          <h3 class="feat__title" id="feat-h">{feature.title}</h3>
          <p class="feat__lede">{feature.lede ?? feature.detail}</p>
          <p class="feat__links">
            <a class="more" href={feature.href}>{feature.label}</a>
            {feature.more?.map((m) => <a class="more" href={m.href}>{m.label}</a>)}
          </p>
        </div>
      </div>
    </article>
    <RecordRows entries={ledger} label="Other teaching, most recent first" />
  </section>

  <section class="sec" id="built" aria-labelledby="built-h">
    <SectionHead title="What I built, and when" id="built-h">
      Personal projects. I built each one with Claude Code, except QuickRamp, a company I co-founded.
    </SectionHead>
    <RecordRows entries={builds} density="line" label="Personal builds, in order" />
    <div class="checked">
      <p class="checked__note">
        All {checked} outside links in this list answered when I checked them on November 25, 2026.
      </p>
      <Stamp
        lines={['Links', 'checked']}
        small="25 Nov 2026"
        label={`${checked} live links checked on November 25, 2026`}
      />
    </div>
  </section>

  <section class="sec edu" id="education" aria-labelledby="education-h">
    <h2 id="education-h" class="edu__h">Education</h2>
    <div class="edu__body">
      <p class="edu__line">
        <span class="edu__when">{degree.when}</span>
        <span class="edu__name">{degree.title}</span>
        <span class="edu__what">{degree.detail}</span>
      </p>
      <p class="edu__courses">Courses: {courses.join('. ')}.</p>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 7.1fr) minmax(0, 2.9fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(28px, 4.5vw, 64px);
  }
  .head :global(h1) {
    font-size: var(--step-hero);
    white-space: pre-line;
  }
  .head__lede {
    margin-top: 22px;
    max-width: 44ch;
    font-size: var(--step-lede);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .head__spot {
    display: grid;
    gap: 10px;
    padding: clamp(20px, 2.4vw, 30px);
  }
  .head__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: clamp(5rem, 10vw, 8.5rem);
    line-height: 0.82;
    font-variant-numeric: tabular-nums;
  }
  .head__what {
    font-size: var(--step-lede);
    line-height: 1.35;
    text-wrap: balance;
  }
  .head__spot .more {
    justify-self: start;
    margin-top: 4px;
  }

  .chart {
    margin-top: clamp(48px, 6vw, 80px);
  }

  /* Section heads sit a size down from the home page, so long names fit the label column. */
  .sec :global(.sec-head h2) {
    font-size: clamp(1.875rem, 3.1vw, 2.75rem);
  }
  .sec :global(.sec-head p:empty) {
    display: none;
  }

  /* Teaching opens on the intensive, set once at full width on the page grid, with the ledger
     under it in the same grammar as Work. */
  .feat {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
    padding: 30px 0 34px;
    border-bottom: var(--rule-dash);
  }
  .feat__when {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }
  .feat__main {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5.4fr);
    gap: var(--col-gap) clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .feat__fig {
    margin: 0;
    width: max-content;
    max-width: 100%;
    display: grid;
    justify-items: start;
    gap: 10px;
  }
  .feat__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: clamp(5rem, 9vw, 8rem);
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }
  /* The same pink block the intensive is drawn with in the chart above. */
  .feat__ink {
    display: block;
    width: 100%;
    height: 14px;
    background: var(--pink);
  }
  .feat__cap {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .feat__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: var(--w-title);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .feat__lede {
    margin-top: 10px;
    max-width: 46ch;
    font-size: var(--step-lede);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .feat__links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .checked {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
    align-items: center;
    padding-top: 26px;
    border-top: var(--rule);
  }
  .checked__note {
    grid-column: 2;
    grid-row: 1;
    max-width: 40ch;
    font-size: var(--step-small);
    color: var(--text-soft);
  }
  .checked :global(.stamp) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    margin-top: -64px;
    margin-right: clamp(0px, 3vw, 40px);
  }

  /* Education: one line under a solid rule, the way the resume sets it. */
  .edu {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
    align-items: baseline;
    margin-top: clamp(64px, 8vw, 104px);
    padding-top: 22px;
    border-top: var(--rule);
  }
  .edu__h {
    font-size: clamp(1.875rem, 3.1vw, 2.75rem);
  }
  .edu__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 22px;
  }
  .edu__when {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .edu__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: var(--w-title);
    font-size: 1.25rem;
  }
  .edu__courses {
    margin-top: 8px;
    font-size: var(--step-small);
    color: var(--text-soft);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .head__spot {
      max-width: 460px;
    }
  }

  @media (max-width: 900px) {
    .feat__main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .feat {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 22px 0 28px;
    }
    .checked,
    .edu {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .edu {
      gap: 10px;
    }
    .checked__note,
    .checked :global(.stamp) {
      grid-column: 1;
      grid-row: auto;
    }
    .checked :global(.stamp) {
      justify-self: start;
      margin: 0 0 0 8px;
    }
  }
</style>
