---
/** Site navigation. Four destinations, named for what a visitor is looking for. */
const links = [
  { href: '/work', label: 'Work' },
  { href: '/teaching', label: 'Teaching' },
  { href: '/path', label: 'Path' },
  { href: '/resume', label: 'Resume' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<nav class="nav" aria-label="Main">
  <a class="nav__name" href="/" aria-current={path === '/' ? 'page' : undefined}>Andrew Yu</a>
  <ul>
    {
      links.map((l) => (
        <li>
          <a class="nav__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0 18px;
  }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 70%;
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: clamp(14px, 3vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
    padding: 6px 0;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
  }
  @media (max-width: 600px) {
    .nav {
      flex-direction: column;
      gap: 8px;
      padding-top: 16px;
    }
  }
</style>
