---
/**
 * Andrew's portrait as a two-ink print: a solid pink disc from one plate, and the
 * photograph as a teal halftone from the other. On dark paper the portrait keeps its
 * own disc of light stock and the day inks, so the face never turns into a negative.
 *
 * The mask is generated by scripts/make-portrait.mjs.
 */
interface Props {
  size?: string;
  /** Print the pink disc under the portrait. Turn it off where another pink field already holds the screen. */
  disc?: boolean;
  class?: string;
}
const { size = '168px', disc = true, class: className } = Astro.props;
---

<div class:list={['portrait', className]} style={`--portrait-size:${size}`} role="img" aria-label="Portrait of Andrew Yu">
  {disc && <span class="portrait__disc plate"></span>}
  <span class="portrait__ink"></span>
</div>

<style>
  .portrait {
    position: relative;
    flex: none;
    width: var(--portrait-size);
    aspect-ratio: 1;
    isolation: isolate;
  }
  .portrait__disc {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    background: var(--pink);
    translate: 3% 2.5%;
  }
  .portrait__ink {
    position: absolute;
    inset: 0;
    background: var(--ink);
    -webkit-mask: url('/img/portrait-halftone.png') center / contain no-repeat;
    mask: url('/img/portrait-halftone.png') center / contain no-repeat;
    mix-blend-mode: var(--blend);
  }
  /* Night: the portrait stays a print on its own disc of light stock, in the day inks.
     Printing it in light ink on dark paper turned the face into a negative. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 1%;
    border-radius: 50%;
    background: var(--stock);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait {
      --stock: #edefea;
      --ink: #0b5f69;
      --pink: #ff4fa3;
      --blend: multiply;
    }
  }
  :global(:root[data-theme='dark']) .portrait {
    --stock: #edefea;
    --ink: #0b5f69;
    --pink: #ff4fa3;
    --blend: multiply;
  }
</style>
