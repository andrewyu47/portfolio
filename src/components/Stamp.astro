---
/**
 * A checkpoint stamp. Two short lines of display type and one small line under them.
 * Reserved for things that were actually checked: a passed checkpoint, a verified result.
 *
 *   <Stamp lines={['Checkpoint', 'passed']} small="Lab 01" label="Checkpoint passed" />
 *
 * Before a checkpoint is passed, its slot holds the ghost: the same disc and ring printed
 * faint, with no words, and hidden from screen readers. Put a one-line `.stamp-how` beside
 * it that says how to earn the stamp. The real stamp lands on top of the ghost.
 *
 *   <Stamp ghost class="cp__ghost" />
 */
type Props =
  | {
      ghost?: false;
      lines: [string] | [string, string];
      small?: string;
      /** What a screen reader should announce. */
      label: string;
      class?: string;
    }
  | { ghost: true; class?: string };
const props = Astro.props;
---

{
  props.ghost ? (
    <div class:list={['stamp', 'stamp--ghost', props.class]} aria-hidden="true" />
  ) : (
    <div class:list={['stamp', props.class]} role="img" aria-label={props.label}>
      <span>
        {props.lines[0]}
        {props.lines[1] && (
          <>
            <br />
            {props.lines[1]}
          </>
        )}
        {props.small && <small>{props.small}</small>}
      </span>
    </div>
  )
}
