---
/**
 * One compact line of the work index: where and when in the label column, then the
 * title and one sentence of context, and a mono "Read" with an arrow at the right edge,
 * so the row looks like a link before anyone hovers it. The whole row opens the case study.
 */
import type { Work } from './sequence';

interface Props {
  entry: Work;
  /** Leave out where the work happened when the group heading already says it. */
  showOrg?: boolean;
}
const { entry, showOrg = true } = Astro.props;
const d = entry.data;
const href = `/work/${entry.id}`;
---

<li class="entry">
  <p class:list={['entry__where label', { 'entry__where--period': !showOrg }]}>
    {showOrg && <>{d.org}<br /></>}<span>{d.period}</span>
  </p>
  <div class="entry__text">
    <h3 class="entry__title"><a href={href}>{d.title}</a></h3>
    <p class="entry__summary">{d.summary}</p>
  </div>
  <span class="entry__read" aria-hidden="true">Read</span>
</li>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--col-gap);
    padding: 18px 0 20px;
    border-bottom: var(--rule-dash);
  }
  .entry:last-child {
    border-bottom: 0;
  }
  .entry__where {
    padding-top: 4px;
  }
  .entry__where span {
    color: var(--text-soft);
  }
  .entry__text {
    padding-right: 5.5rem;
  }

  .entry__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: var(--w-title);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    line-height: 1.1;
  }
  .entry__title a {
    text-decoration: none;
  }
  /* The whole row opens the case study. */
  .entry__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entry__title a:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .entry:has(a:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--pink);
  }
  .entry:hover .entry__title a,
  .entry:has(a:focus-visible) .entry__title a {
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .entry__summary {
    margin-top: 8px;
    font-size: 1.0625rem;
    line-height: 1.45;
    max-width: 60ch;
  }

  /* At rest the row already says it opens: a mono "Read" with an arrow, flush right. */
  .entry__read {
    position: absolute;
    right: 0;
    top: 22px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .entry__read::after {
    content: '\00a0\2192';
  }
  .entry:hover .entry__read {
    text-decoration-thickness: 3px;
  }

  @media (max-width: 600px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 18px 0 20px;
    }
    .entry__where {
      padding-top: 0;
    }
    .entry__where br {
      display: none;
    }
    .entry__where:not(.entry__where--period) span::before {
      content: ' \00b7  ';
      color: var(--ink);
    }
    .entry__text {
      padding-right: 0;
    }
    .entry__read {
      position: static;
      justify-self: start;
    }
  }
</style>
