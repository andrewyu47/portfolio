---
/**
 * One lab sheet in miniature: lab 02 of launch-day-labs, "Give Claude a tool".
 *
 * Predict is the sheet's own question and its three options, word for word. Check is what
 * check.py printed for the finished lab on the first live run, November 27, 2026. The
 * option the run confirmed carries the pink mark, because this figure explains how the
 * labs work; the lab itself never shows the answer before the learner commits to one.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const alt =
  'A lab sheet in two parts. Predict: you send a customer question and two tool definitions in one call, and choose what comes back: the finished answer, a request naming a tool and no answer, or an error. Check: the prediction checkpoint passed. What happened was b. The evidence is that call 1 stopped at tool_use asking for lookup_order, and your code had run no tool yet.';
---

<figure class:list={['sheetfig', className]} data-print="wipe">
  <div class="sheetfig__parts" role="img" aria-label={alt}>
    <div class="sheetfig__part" aria-hidden="true">
      <p class="field">Predict</p>
      <p class="sheetfig__q">
        You send the question and both tool definitions in one call. What comes back from that one call?
      </p>
      <ul class="sheetfig__opts">
        <li><b>a</b><span>the finished answer with the order status</span></li>
        <li class="sheetfig__opt--key"><b>b</b><span>a request naming a tool and its arguments, and no answer</span></li>
        <li><b>c</b><span>an error, because nothing ran the tool</span></li>
      </ul>
    </div>
    <div class="sheetfig__part" aria-hidden="true">
      <p class="field">Check</p>
      <p class="sheetfig__out">
        <span>CHECKPOINT PASSED [02.2] Prediction check</span>
        <span>What happened: b.</span>
        <span>
          Evidence: call 1 stopped at tool_use asking for lookup_order('PK-1004'), and your code had run no tool
          yet
        </span>
      </p>
    </div>
  </div>
  <figcaption>
    Lab 02. The question is the sheet's own. The checkpoint lines are what the check printed on the live run of
    November 27, 2026.
  </figcaption>
</figure>

<style>
  .sheetfig__parts {
    display: grid;
    border-top: var(--rule);
    border-bottom: var(--rule);
  }
  .sheetfig__part {
    padding: 16px 0;
  }
  .sheetfig__part + .sheetfig__part {
    border-top: var(--rule-dash);
  }
  .sheetfig__part .field {
    margin: 0 0 8px;
  }
  .sheetfig__q {
    margin: 0 0 10px;
    font-size: var(--step-small);
    line-height: 1.4;
  }
  .sheetfig__opts {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheetfig__opts li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 8px;
    align-items: baseline;
    margin: 0;
    padding: 6px 10px;
    border: 1.5px solid var(--ink);
    font-size: var(--step-small);
    line-height: 1.3;
  }
  .sheetfig__opts b {
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
  }
  /* The answer the live run confirmed: a pink edge, never a filled slab. */
  .sheetfig__opts .sheetfig__opt--key {
    border-left: 7px solid var(--pink);
    font-weight: 700;
  }
  .sheetfig__out {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 12px 14px;
    background: var(--ink-tint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .sheetfig__out span + span {
    padding-left: 1.5em;
  }
</style>
