---
/**
 * The eval result from "The score that lied", drawn in the two inks.
 * Four documentation conditions across, task success up the side, one series per model:
 * the small model (Claude Haiku 4.5) in teal circles, the large model (Claude Sonnet 4.6)
 * in navy squares. The curated docs file is the point that matters, so it is marked in pink.
 *
 * Numbers come only from the results table in src/content/work/the-score-that-lied.mdx
 * (pinecone-10 to pinecone-15 in the fact base). Each value is the share of 45 runs that passed.
 *
 * Points and labels are HTML so the type stays at its real size on a phone. The two lines
 * that join each series are one SVG stretched to the plot, with strokes that do not scale.
 *
 *   <EvalChart />            beside the case study title
 *   <EvalChart compact />    on the work index: no caption
 */
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;

const conditions = [
  { name: 'No docs', lines: ['No docs'], small: 11, large: 84 },
  { name: 'Curated docs file', lines: ['Curated', 'file'], small: 89, large: 100, key: true },
  { name: 'Live docs through MCP', lines: ['MCP'], small: 4, large: 51 },
  { name: 'Live docs through web fetch', lines: ['Web', 'fetch'], small: 18, large: 84 },
];
const x = (i: number) => ((i + 0.5) / conditions.length) * 100;
const line = (k: 'small' | 'large') => conditions.map((c, i) => `${x(i) * 4},${100 - c[k]}`).join(' ');

const summary =
  'Task success on 15 developer tasks, by documentation condition. ' +
  conditions.map((c) => `${c.name}: small model ${c.small}%, large model ${c.large}%.`).join(' ') +
  ' The curated docs file is the best condition for both models.';
---

<figure class:list={['evalchart', { 'evalchart--compact': compact }, className]} data-print>
  <p class="evalchart__key" aria-hidden="true">
    <span><i class="mk mk--small"></i>Small model, Claude Haiku 4.5</span>
    <span><i class="mk mk--large"></i>Large model, Claude Sonnet 4.6</span>
  </p>
  <div class="evalchart__body">
    <div class="evalchart__plot" role="img" aria-label={summary}>
      <span class="grid grid--100" aria-hidden="true"><span class="grid__n">100%</span></span>
      <span class="grid grid--50" aria-hidden="true"><span class="grid__n">50</span></span>
      <span class="grid grid--0" aria-hidden="true"><span class="grid__n">0</span></span>
      <div class="evalchart__area" aria-hidden="true">
        <svg class="evalchart__lines" viewBox="0 0 400 100" preserveAspectRatio="none">
          <polyline class="ln ln--large" points={line('large')}></polyline>
          <polyline class="ln ln--small" points={line('small')}></polyline>
        </svg>
        {
          conditions.map((c, i) => (
            <>
              {(['large', 'small'] as const).map((k) => (
                <span
                  class:list={['pt', `pt--${k}`, { 'pt--key': c.key }]}
                  style={`left:${x(i)}%;bottom:${c[k]}%;--i:${i}`}
                >
                  {c.key && <span class="pt__mark plate" />}
                  <i class={`mk mk--${k}`} />
                  <span class="pt__v">{c[k]}%</span>
                </span>
              ))}
            </>
          ))
        }
      </div>
    </div>
    <ol class="evalchart__x" aria-hidden="true">
      {
        conditions.map((c) => (
          <li class:list={{ 'is-key': c.key }}>
            {c.lines.map((l) => (
              <span>{l}</span>
            ))}
          </li>
        ))
      }
    </ol>
  </div>
  {
    !compact && (
      <figcaption>
        Share of runs that passed. Each point is 45 runs: 15 tasks, three runs each. MCP and web fetch both read the
        live docs.
      </figcaption>
    )
  }
</figure>

<style>
  .evalchart {
    --plot-h: 236px;
    --axis: 2.6rem;
    --label-room: 2.9rem;
    max-width: 520px;
  }
  .evalchart--compact {
    --plot-h: 172px;
  }

  /* The key: marker shapes as well as colors, so the series never depend on color alone. */
  .evalchart__key {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text);
  }
  .evalchart__key span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .evalchart__body {
    display: grid;
    grid-template-columns: var(--axis) minmax(0, 1fr);
  }
  .evalchart__plot {
    grid-column: 1 / -1;
    position: relative;
    height: var(--plot-h);
    margin-top: 10px;
  }

  /* Gridlines at 0, 50 and 100, numbered in the axis gutter. */
  .grid {
    position: absolute;
    left: var(--axis);
    right: 0;
    border-top: var(--rule-dash);
  }
  .grid--100 {
    top: 0;
  }
  .grid--50 {
    top: 50%;
  }
  .grid--0 {
    top: 100%;
    border-top: var(--rule);
  }
  .grid__n {
    position: absolute;
    right: calc(100% + 8px);
    top: 0;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .evalchart__area {
    position: absolute;
    inset: 0 var(--label-room) 0 var(--axis);
  }
  .evalchart__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ln {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .ln--small {
    stroke: var(--ink);
  }
  .ln--large {
    stroke: var(--text);
    stroke-dasharray: 5 4;
  }

  /* Printing on arrival: the two lines are drawn left to right, each point appears as
     the line reaches it, and the pink rings land last (the shared .plate rule). */
  .evalchart__lines {
    clip-path: inset(-20% 0 -20% 0);
    transition: clip-path 0.9s cubic-bezier(0.5, 0, 0.3, 1) 0.1s;
  }
  .pt .mk,
  .pt__v {
    transition: opacity 0.2s linear calc(0.15s + var(--i, 0) * 0.24s);
  }
  :global(.js) .evalchart:not([data-printed]) .evalchart__lines {
    clip-path: inset(-20% 100% -20% 0);
  }
  :global(.js) .evalchart:not([data-printed]) .pt .mk,
  :global(.js) .evalchart:not([data-printed]) .pt__v {
    opacity: 0;
  }
  .evalchart :global(.plate) {
    transition-delay: 1s;
  }

  /* Markers: a teal circle for the small model, a navy square for the large one. */
  .mk {
    display: inline-block;
    flex: none;
    width: 12px;
    height: 12px;
  }
  .mk--small {
    border-radius: 50%;
    background: var(--ink);
  }
  .mk--large {
    background: var(--text);
  }

  .pt {
    position: absolute;
    width: 0;
    height: 0;
  }
  .pt .mk {
    position: absolute;
    left: -6px;
    top: -6px;
    box-shadow: 0 0 0 2.5px var(--stock);
  }
  .pt__mark {
    position: absolute;
    left: -13px;
    top: -13px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--pink);
  }
  .pt__v {
    position: absolute;
    left: 13px;
    top: 0;
    translate: 0 -55%;
    padding: 0 3px;
    background: var(--stock);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pt--key .pt__v {
    left: 17px;
  }

  /* Condition names under the plot, centered on their points. */
  .evalchart__x {
    grid-column: 2;
    list-style: none;
    margin: 12px var(--label-room) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .evalchart__x li {
    display: grid;
    justify-items: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text);
    white-space: nowrap;
  }
  .evalchart__x li.is-key span {
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .evalchart {
      --plot-h: 210px;
      --axis: 2.4rem;
      --label-room: 2.6rem;
    }
    .evalchart__x li {
      font-size: 0.8125rem;
    }
  }
</style>
