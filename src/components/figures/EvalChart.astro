---
/**
 * The eval result from "The score that lied", drawn in the two inks as a dot plot.
 * One row per documentation condition on a shared scale from 0 to 100. Each row carries
 * two marks: a teal circle for the small model (Claude Haiku 4.5) and a navy square for
 * the large model (Claude Sonnet 4.6), joined by a thin rule, with both values printed at
 * the end of the row. The curated docs file is the row that matters, so it sits on pink.
 *
 * The four conditions have no order, so they are rows, not points along a line.
 *
 * This chart is the case study's only full record of the results: the page has no table,
 * and its prose names the conditions with the labels used here (No docs, Curated docs
 * file, MCP, Web fetch). Each value is the share of 45 runs that passed.
 *
 *   <EvalChart />            beside the case study title
 *   <EvalChart compact />    on the work index: no caption
 */
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;

const conditions = [
  { name: 'No docs', small: 11, large: 84 },
  { name: 'Curated docs file', small: 89, large: 100, key: true },
  { name: 'Live docs through MCP', short: 'MCP', small: 4, large: 51 },
  { name: 'Live docs through web fetch', short: 'Web fetch', small: 18, large: 84 },
];

const summary =
  'Task success on 15 developer tasks, by documentation condition. ' +
  conditions.map((c) => `${c.name}: small model ${c.small}%, large model ${c.large}%.`).join(' ') +
  ' The curated docs file is the best condition for both models.';
---

<figure class:list={['evalchart', { 'evalchart--compact': compact }, className]} data-print>
  <div class="ec" role="img" aria-label={summary}>
    <div class="ec__row ec__row--head" aria-hidden="true">
      <span></span>
      <span class="ec__scale"><span>0</span><span>50</span><span>100%</span></span>
      <span class="ec__v"><i class="mk mk--small"></i></span>
      <span class="ec__v"><i class="mk mk--large"></i></span>
    </div>
    {
      conditions.map((c, i) => (
        <div class:list={['ec__row', { 'is-key': c.key }]} style={`--i:${i}`} aria-hidden="true">
          {c.key && <span class="ec__band plate" />}
          <span class="ec__name">{c.short ?? c.name}</span>
          <span class="ec__track">
            <span
              class="ec__link"
              style={`left:${Math.min(c.small, c.large)}%;width:${Math.abs(c.large - c.small)}%`}
            />
            <i class="mk mk--small" style={`left:${c.small}%`} />
            <i class="mk mk--large" style={`left:${c.large}%`} />
          </span>
          <span class="ec__v">{c.small}%</span>
          <span class="ec__v">{c.large}%</span>
        </div>
      ))
    }
  </div>
  <p class="ec__key" aria-hidden="true">
    <span><i class="mk mk--small"></i>Small model, Claude Haiku 4.5</span>
    <span><i class="mk mk--large"></i>Large model, Claude Sonnet 4.6</span>
  </p>
  {
    !compact && (
      <figcaption>
        Each mark is the share of 45 runs that passed: 15 tasks, three runs each. MCP and web fetch both read the live
        docs.
      </figcaption>
    )
  }
</figure>

<style>
  .evalchart {
    container-type: inline-size;
  }
  .ec {
    display: grid;
    border-bottom: var(--rule);
  }
  .ec__row {
    position: relative;
    isolation: isolate;
    display: grid;
    /* The name column fits "Curated docs file" on one line, the longest label. */
    grid-template-columns: minmax(8.75rem, 2.6fr) minmax(0, 5fr) 3.4rem 3.4rem;
    align-items: center;
    column-gap: 14px;
    min-height: 44px;
    padding: 0 10px;
    border-top: var(--rule-dash);
  }
  .ec__row--head {
    min-height: 30px;
    border-top: 0;
    border-bottom: var(--rule);
    align-items: end;
    padding-bottom: 6px;
  }
  .ec__row--head + .ec__row {
    border-top: 0;
  }
  .ec__name {
    font-size: var(--step-small);
    line-height: 1.25;
  }
  .is-key .ec__name {
    font-weight: 700;
  }

  /* The scale: three ticks over the track, and three hairlines down through every row. */
  .ec__scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .ec__scale span:nth-child(2) {
    translate: 6px 0;
  }
  .ec__track {
    position: relative;
    align-self: stretch;
    background:
      linear-gradient(var(--ink), var(--ink)) 0 0 / 1px 100% no-repeat,
      linear-gradient(var(--ink), var(--ink)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--ink), var(--ink)) 100% 0 / 1px 100% no-repeat;
  }
  .is-key .ec__track {
    background-image:
      linear-gradient(var(--over), var(--over)), linear-gradient(var(--over), var(--over)),
      linear-gradient(var(--over), var(--over));
  }
  .ec__link {
    position: absolute;
    top: calc(50% - 1px);
    height: 2px;
    background: var(--text);
    transform-origin: left center;
    transition: transform 0.5s cubic-bezier(0.3, 0, 0.2, 1) calc(0.25s + var(--i, 0) * 0.16s);
  }

  /* Marks: a teal circle for the small model, a navy square for the large one. */
  .mk {
    display: inline-block;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .mk--small {
    border-radius: 50%;
    background: var(--ink);
  }
  .mk--large {
    background: var(--text);
  }
  .ec__track .mk {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
    box-shadow: 0 0 0 2px var(--stock);
    transition: opacity 0.2s linear calc(0.15s + var(--i, 0) * 0.16s);
  }
  .is-key .ec__track .mk {
    box-shadow: 0 0 0 2px var(--pink);
  }
  .is-key .mk--small {
    background: var(--over);
    border-radius: 50%;
    outline: 2px solid var(--over);
    outline-offset: 2px;
  }
  .is-key .mk--large {
    background: var(--over);
  }

  .ec__v {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: 1.375rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    line-height: 1;
  }
  .ec__row--head .ec__v {
    display: flex;
    justify-content: flex-end;
    padding-right: 4px;
  }

  /* The row that matters is printed on the pink plate, with navy type over it. */
  .ec__band {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--pink);
  }
  .is-key {
    color: var(--over);
  }

  .ec__key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .ec__key span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ec__key .mk {
    width: 11px;
    height: 11px;
  }

  /* Printing on arrival: each row's two marks appear, the rule between them is drawn,
     and the pink plate lands last (the shared .plate rule in global.css). */
  :global(.js) .evalchart:not([data-printed]) .ec__track .mk {
    opacity: 0;
  }
  :global(.js) .evalchart:not([data-printed]) .ec__link {
    transform: scaleX(0);
  }
  .evalchart :global(.plate) {
    transition-delay: 0.85s;
  }

  @container (max-width: 430px) {
    .ec__row {
      grid-template-columns: minmax(0, 1fr) 2.9rem 2.9rem;
      grid-template-rows: auto auto;
      row-gap: 4px;
      padding: 8px 8px 10px;
    }
    .ec__row--head {
      grid-template-rows: auto;
      padding: 0 8px 6px;
    }
    .ec__row--head > span:first-child {
      display: none;
    }
    .ec__row--head .ec__scale {
      grid-column: 1;
    }
    .ec__name {
      grid-column: 1;
      grid-row: 1;
    }
    .ec__track {
      grid-column: 1;
      grid-row: 2;
      height: 22px;
    }
    .ec__row:not(.ec__row--head) .ec__v {
      grid-row: 1 / span 2;
      align-self: center;
    }
    .ec__v {
      font-size: 1.1875rem;
    }
  }
</style>
