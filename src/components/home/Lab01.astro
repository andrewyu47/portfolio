---
/**
 * The home page hero. It is a lab sheet, because writing labs is the job: the claim
 * beside a print of the room it was made in, a caption that says who is making it, and a
 * one-question lab the visitor can finish on the first screen.
 *
 * One grid runs through the sheet. The worksheet keeps the hero's lines: its step ends
 * where the claim ends, and its checkpoint hangs from the print's left edge. On a phone
 * the checkpoint has no cell of its own. Its ring sits at the top right of Step 1, and
 * the stamp lands there.
 *
 * The print's pink disc is the one pink field of this screen.
 */
import Sheet from '../Sheet.astro';
import Overprint from '../Overprint.astro';
import Photo from '../Photo.astro';
import Stamp from '../Stamp.astro';
import profile from '../../data/profile.json';

const [salesforce, dojo] = profile.roles;
---

<Sheet label="Lab 01 · Who runs the tool?" meta="Time: 1 minute" labelledby="thesis" class="lab01" id="lab-01">
  <div class="hero">
    <div class="hero__claim">
      <Overprint as="h1" id="thesis" text={profile.thesis} />
      <p class="lede">{profile.support}</p>
    </div>

    <figure class="room">
      <Photo
        print="room-capstone-tight"
        alt="Andrew at a microphone beside a screen whose slide reads: Build a tool that proves you can already do the job."
      />
      <figcaption>
        <p class="room__who">
          <span class="nowrap">{salesforce.title}</span> at {salesforce.org}, and <span class="nowrap"
            >{dojo.title}</span
          > at {dojo.org}, a nonprofit.
        </p>
        <p class="room__when">
          <a href="#teach">Teaching people to build with Claude Code</a> at its intensive, <span class="nowrap"
            >July 11, 2026.</span
          > <a class="more" href="/work/claude-dojo#clip">Watch 55 seconds</a>
        </p>
      </figcaption>
    </figure>
  </div>

  <div class="lab" data-state="idle" data-lab01>
    <div class="lab__brief">
      <h2 class="field">Objective</h2>
      <p>Find out who runs the tool when an agent uses one: the model or your code.</p>
      <h2 class="field">You will need</h2>
      <p>This page. Nothing to install.</p>
    </div>

    <div class="lab__step">
      <h2 class="field">Step 1</h2>
      <p class="lab__q">
        You send a model one question and one tool it may use, <code>search_portfolio</code>. Who runs the search?
      </p>
      <div class="lab__choices" role="group" aria-label="Who runs the search?">
        <button class="check" type="button" data-pick="model" aria-pressed="false">
          <span class="check__box"
            ><svg class="check__mark" viewBox="0 0 44 44" aria-hidden="true"
              ><path pathLength="1" d="M9 12 L35 36 M35 11 L10 37"></path></svg
            ></span
          >
          The model
        </button>
        <button class="check" type="button" data-pick="code" aria-pressed="false">
          <span class="check__box"
            ><svg class="check__mark" viewBox="0 0 44 44" aria-hidden="true"
              ><path pathLength="1" d="M8 24 L18 35 L38 7"></path></svg
            ></span
          >
          Your code
        </button>
      </div>
      <div class="lab__result" aria-live="polite">
        <p data-when="idle">Tick one to reach the checkpoint.</p>
        <p data-when="right">
          <strong>Expected output.</strong> The model only replies with a request to call the tool. Your code runs it and
          sends the result back. <a href="#lab-02">Lab 02</a> shows every message.
        </p>
        <p data-when="wrong">
          <strong>If it fails.</strong> That is the common first guess. The model never runs anything on its own. Try the
          other box, or step through <a href="#lab-02">Lab 02</a> and watch who does what.
        </p>
      </div>
    </div>

    <div class="lab__checkpoint">
      <h2 class="field">Checkpoint</h2>
      <div class="lab__stamp-slot">
        <span class="lab__stamp-empty label" aria-hidden="true"
          ><span>Stamp<span class="lab__stamp-where"><br />goes here</span></span></span
        >
        <Stamp lines={['Checkpoint', 'passed']} small="Lab 01" label="Checkpoint passed" class="lab__stamp" />
      </div>
    </div>
  </div>
</Sheet>

<style>
  /* One grid for the whole sheet. --gap is the gutter between the claim and the print,
     and the claim takes 61% of what is left. The worksheet reuses both numbers. */
  .hero,
  .lab {
    --gap: clamp(24px, 3.4vw, 52px);
    --claim: calc((100% - var(--gap)) * 0.61);
  }

  /* ---------- The hero: the claim on the left, the room on the right ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6.1fr) minmax(0, 3.9fr);
    column-gap: var(--gap);
    align-items: start;
    /* The worksheet's top rule closes the hero: one rule, the full width of the sheet. */
    padding: clamp(20px, 2.6vw, 34px) 0 26px;
  }
  .hero__claim :global(h1) {
    font-size: clamp(3rem, 5.9vw, 5.375rem);
  }
  .lede {
    margin-top: clamp(18px, 2vw, 26px);
  }

  /* The print's top edge sits on the cap line of the headline, so the two read as one statement. */
  .room {
    padding-top: calc(clamp(3rem, 5.9vw, 5.375rem) * 0.1);
  }
  /* A shorter crop of the print, so the answer still clears the fold of an 800px window. */
  .room :global(.photo) {
    aspect-ratio: 1220 / 700;
  }
  .room figcaption {
    margin-top: 10px;
    color: var(--text);
  }
  /* Who is at the microphone, in the reading face, then the dated caption of the print. */
  .room__who {
    font-family: var(--font-body);
    font-size: var(--step-small);
    line-height: 1.4;
  }
  .room__when {
    margin-top: 4px;
  }
  .room__when .more,
  .nowrap {
    white-space: nowrap;
  }

  /* ---------- The worksheet ---------- */

  .lab {
    display: grid;
    /* The label column, then the rest of the claim column, then the print's column. Each
       dashed divider stands in the middle of a gutter, so the step's text ends where the
       claim ends and the checkpoint starts where the print starts. */
    grid-template-columns: 23% calc(var(--claim) + var(--gap) / 2 - 23%) minmax(0, 1fr);
    border-top: var(--rule);
    /* The sheet is closed with a rule, the way the bottom of a handout is. */
    border-bottom: var(--rule);
    padding-bottom: 10px;
    /* The stamp starts oversized before it lands; it must never widen the page. */
    overflow-x: clip;
    overflow-clip-margin: 12px;
  }
  /* Each cell sets its own padding and divider, so the narrower layouts below can
     override them one for one. */
  .lab > .lab__brief {
    padding: 16px 24px 8px 0;
  }
  .lab > .lab__step {
    padding: 16px calc(var(--gap) / 2) 8px 24px;
    border-left: var(--rule-dash);
  }
  .lab > .lab__checkpoint {
    /* Less the divider's own pixel, so the ring starts exactly on the print's left edge. */
    padding: 16px 0 8px calc(var(--gap) / 2 - 1px);
    border-left: var(--rule-dash);
  }
  .lab__brief p {
    font-size: var(--step-small);
    line-height: 1.45;
    margin-bottom: 16px;
  }
  .lab__q {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.35;
    margin-bottom: 14px;
  }
  /* The two boxes stay on one line: the gap between them gives way first on a narrow laptop. */
  .lab__choices {
    display: flex;
    gap: 8px clamp(18px, 5vw - 38px, 34px);
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  /* The three replies share one cell, so the sheet always has the height of the longest
     and nothing under it moves when someone answers. */
  .lab__result {
    display: grid;
    font-size: var(--step-small);
    line-height: 1.45;
    max-width: 60ch;
  }
  .lab__result p {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .lab[data-state='idle'] [data-when='idle'],
  .lab[data-state='right'] [data-when='right'],
  .lab[data-state='wrong'] [data-when='wrong'] {
    visibility: visible;
  }
  [data-when='idle'] {
    color: var(--text-soft);
  }

  .lab__stamp-slot {
    position: relative;
    width: 150px;
    height: 150px;
    margin-top: 6px;
  }
  .lab__stamp-empty {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed var(--ink);
    display: grid;
    place-items: center;
    text-align: center;
    transition: opacity 0.15s;
  }
  /* The stamp is not there until the checkpoint is passed, for a screen reader too. */
  .lab :global(.lab__stamp) {
    position: absolute;
    inset: 0;
    opacity: 0;
    scale: 1.5;
    visibility: hidden;
    transition:
      opacity 0.12s,
      scale 0.28s var(--ease-stamp),
      visibility 0s linear 0.28s;
  }
  .lab[data-state='right'] :global(.lab__stamp) {
    opacity: 1;
    scale: 1;
    visibility: visible;
    transition:
      opacity 0.12s,
      scale 0.28s var(--ease-stamp),
      visibility 0s;
  }
  .lab[data-state='right'] .lab__stamp-empty {
    opacity: 0;
  }

  /* ---------- Narrow laptops and tablets ---------- */

  /* Below this width the step column under the claim is too narrow for both boxes on one
     line, so the worksheet stacks: what it is for, then the step beside the checkpoint. */
  @media (max-width: 1099px) {
    .lab {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .lab__choices {
      column-gap: 34px;
    }
    .lab > .lab__brief {
      grid-column: 1 / -1;
      grid-row: 1;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 14px;
      align-items: baseline;
      padding: 16px 0 14px;
      border-bottom: var(--rule-dash);
    }
    .lab__brief .field,
    .lab__brief p {
      margin: 0;
    }
    .lab > .lab__step {
      grid-column: 1;
      grid-row: 2;
      padding: 16px 24px 8px 0;
      border-left: 0;
    }
    .lab > .lab__checkpoint {
      grid-column: 2;
      grid-row: 2;
      padding: 16px 0 8px 24px;
    }
  }

  /* One column for the hero: the claim, then the print with its caption beside it. */
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
      padding: clamp(26px, 4vw, 52px) 0 clamp(22px, 2vw, 26px);
    }
    .hero__claim :global(h1) {
      font-size: var(--step-hero);
    }
    .room {
      padding-top: 0;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 24px;
      align-items: end;
    }
    .room :global(.photo) {
      aspect-ratio: var(--photo-ratio);
    }
    .room figcaption {
      margin-top: 0;
    }
  }

  /* ---------- Phones ---------- */

  @media (max-width: 600px) {
    /* The question comes straight after the claim: the band at the top promises a lab,
       so the lab is the next thing you reach. The room follows it. */
    :global(.lab01) {
      display: flex;
      flex-direction: column;
    }
    .hero {
      display: contents;
    }
    .hero__claim {
      order: 1;
      padding-top: 22px;
    }
    .hero__claim :global(h1) {
      max-width: none;
    }
    .lab {
      order: 2;
      margin-top: 20px;
      grid-template-columns: minmax(0, 1fr);
    }
    /* The worksheet's closing rule is the only rule between the lab and the room. */
    .room {
      order: 3;
      display: block;
      margin-top: 26px;
    }
    .room figcaption {
      margin-top: 10px;
    }

    /* The brief stacks. Its last line is short, which leaves the corner over the dashed
       rule clear for the stamp. */
    .lab > .lab__brief {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 14px 0 12px;
    }
    .lab__brief p + .field {
      margin-top: 8px;
    }
    .lab > .lab__step {
      padding: 14px 0 6px;
    }

    /* The checkpoint shares the Step 1 cell: its ring stands at the top right, level with
       the label, and pokes a few pixels over the dashed rule above. The label leaves room
       under it so the ring never touches the question. */
    .lab > .lab__step,
    .lab > .lab__checkpoint {
      grid-column: 1;
      grid-row: 2;
    }
    .lab > .lab__checkpoint {
      justify-self: end;
      align-self: start;
      padding: 0;
      margin-top: -7px;
      border-left: 0;
    }
    .lab__step .field {
      margin-bottom: 14px;
    }
    .lab__checkpoint .field {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .lab__stamp-slot {
      width: 56px;
      height: 56px;
      margin: 0;
    }
    .lab__stamp-empty {
      font-size: 0.6875rem;
    }
    .lab__stamp-where {
      display: none;
    }
    /* The stamp is bigger than its ring, so its words stay legible. It lands on the corner
       of the step, across the dashed rule, clear of the question under it. */
    .lab :global(.lab__stamp) {
      inset: auto 2px -4px auto;
      width: 94px;
      height: 94px;
      font-size: 0.8125rem;
    }
    .lab :global(.lab__stamp)::before {
      inset: 5px;
    }
    .lab :global(.lab__stamp small) {
      margin-top: 4px;
      font-size: 0.625rem;
    }
  }

  /* On the narrowest phones the two boxes still share a line. */
  @media (max-width: 379px) {
    .lab__choices {
      column-gap: 12px;
    }
  }
</style>

<script>
  // Lab 01: one question, two boxes. Ticking "Your code" passes the checkpoint.
  const lab = document.querySelector<HTMLElement>('[data-lab01]');
  if (lab) {
    const boxes = [...lab.querySelectorAll<HTMLButtonElement>('.check')];
    for (const box of boxes) {
      box.addEventListener('click', () => {
        for (const other of boxes) other.setAttribute('aria-pressed', String(other === box));
        lab.dataset.state = box.dataset.pick === 'code' ? 'right' : 'wrong';
      });
    }
  }
</script>
