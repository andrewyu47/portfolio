---
/**
 * The close of the home page: one line that says where to reach Andrew, with the
 * addresses under it, and one line for visitors who arrive with an agent instead of a browser.
 */
import profile from '../../data/profile.json';

const handle = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section class="sec reach" id="reach" aria-labelledby="reach-h">
  <h2 id="reach-h" class="reach__line">
    Reach me on <a href={profile.links.linkedin} rel="me">LinkedIn</a> or <a href={profile.links.github} rel="me"
      >GitHub</a
    >.
  </h2>
  <p class="reach__handles">
    <span>{handle(profile.links.linkedin)}</span>
    <span>{handle(profile.links.github)}</span>
  </p>
  <p class="agent">
    <span>This site is also an MCP server, so you can connect an AI client to it and ask about my work.</span>
    <a class="more" href="/teaching/connect">Lab 03: Ask this site a question</a>
  </p>
</section>

<style>
  .reach__line {
    font-size: var(--step-h2);
    line-height: 1;
    max-width: 22ch;
  }
  .reach__line a {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.1em;
  }
  .reach__line a:hover {
    text-decoration-color: var(--pink);
  }
  .reach__handles {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .agent {
    margin-top: clamp(28px, 3.4vw, 40px);
    padding-top: 14px;
    border-top: var(--rule);
    font-size: var(--step-small);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
  }
</style>
