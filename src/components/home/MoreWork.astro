---
/**
 * More work, as a ledger a reader can scan and open: title with where and when,
 * one line on what happened, the figure pulled out at the right where one is on
 * record, and an arrow that says the row opens. Five rows at most. The rest is on /work.
 *
 * The rows and their wording are chosen here for this page, so a number published
 * once elsewhere (a ticket count, a contributor count) never reaches the home page.
 * Entries are read from the work collection for their titles, so a draft or a
 * missing case study drops out on its own.
 */
import { getCollection } from 'astro:content';

type Line = { when: string; line: string; figure?: { value: string; label: string } };
const LEDGER: Record<string, Line> = {
  salesforce: {
    when: 'Salesforce · Jul 2026 to present',
    line: 'I proposed an ownership model for agent skills: the docs are the source, and evals run with and without the docs are the proof.',
  },
  'pinecone-search-docs': {
    when: 'Pinecone · Feb 2026 to Jul 2026',
    line: 'I was the sole author of the Search SDK and API reference, written for developers and for the AI assistants that retrieve from it.',
  },
  'docops-governance-workbench': {
    when: 'Splunk · Repository created December 2025',
    line: 'A workbench that checks developer docs against the live API spec and the style guide before they ship.',
    figure: { value: '40%', label: 'less manual review time' },
  },
  sage: {
    when: 'Splunk · Between 2020 and 2026',
    line: "Draw a box around any part of a product screen and get an answer from the docs. It won the People's Choice Award and placed second overall at an AI hackathon.",
    figure: { value: '2nd', label: 'overall at an AI hackathon' },
  },
};
const PERSONAL = ['quickramp', 'fold', 'youtube-content-pipeline'];

const all = await getCollection('work', ({ data }) => !data.draft);
const byId = new Map(all.map((e) => [e.id, e]));
const rows = Object.entries(LEDGER)
  .filter(([id]) => byId.has(id))
  .slice(0, 5)
  .map(([id, l]) => ({ id, title: byId.get(id)!.data.title, ...l }));
const personal = PERSONAL.filter((id) => byId.has(id)).map((id) => ({ id, title: byId.get(id)!.data.title }));
---

{
  rows.length > 0 && (
    <section class="sec more-work" id="more-work" aria-labelledby="more-work-h">
      <div class="mw__head">
        <h2 id="more-work-h">More work</h2>
        <a class="more" href="/work">
          All work
        </a>
      </div>
      <ul class="ledger">
        {rows.map((r) => (
          <li>
            <div class="ledger__name">
              <a class="ledger__title" href={`/work/${r.id}`}>
                {r.title}
              </a>
              <p class="ledger__when">{r.when}</p>
            </div>
            <p class="ledger__line">{r.line}</p>
            <p class="ledger__fig">
              {r.figure && (
                <>
                  <span class="numeral">{r.figure.value}</span>
                  <span class="ledger__fig-label">{r.figure.label}</span>
                </>
              )}
            </p>
            <span class="ledger__go" aria-hidden="true">
              Read
            </span>
          </li>
        ))}
      </ul>
      {personal.length > 0 && (
        <p class="personal">
          <span class="label">Personal projects</span>
          {personal.map((p) => (
            <a class="more" href={`/work/${p.id}`}>
              {p.title}
            </a>
          ))}
        </p>
      )}
    </section>
  )
}

<style>
  /* The head runs the full measure: title at the left, the way out at the right. */
  .mw__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: var(--rule);
  }
  .mw__head h2 {
    font-size: var(--step-h2);
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ledger li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3.1fr) minmax(0, 4.6fr) minmax(0, 1.7fr) 3.4rem;
    gap: var(--col-gap);
    align-items: start;
    padding: 20px 0 22px;
    border-bottom: var(--rule-dash);
  }
  .ledger__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-title);
    font-size: 1.3125rem;
    line-height: 1.2;
    text-decoration: none;
  }
  /* The whole row opens the case study. */
  .ledger__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ledger__title:focus-visible {
    outline: none;
  }
  .ledger li:has(.ledger__title:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .ledger__when {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .ledger__line {
    font-size: 1.0625rem;
    line-height: 1.45;
    max-width: 52ch;
  }
  .ledger__fig {
    display: grid;
    justify-items: end;
    text-align: right;
    gap: 6px;
  }
  .ledger__fig .numeral {
    font-size: clamp(2.75rem, 4.4vw, 3.75rem);
  }
  .ledger__fig-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .ledger__go {
    justify-self: end;
    padding-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .ledger__go::after {
    content: '\00a0\2192';
    color: var(--text);
  }
  .ledger li:hover .ledger__title {
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }
  .ledger li:hover .ledger__go {
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
  }

  .personal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    margin-top: 18px;
  }

  @media (max-width: 900px) {
    .ledger li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px 20px;
    }
    .ledger__name {
      grid-column: 1;
    }
    .ledger__line {
      grid-column: 1;
    }
    .ledger__fig {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .ledger__go {
      grid-column: 1 / -1;
      justify-self: start;
      padding-top: 0;
    }
  }
  @media (max-width: 600px) {
    .ledger li {
      grid-template-columns: minmax(0, 1fr);
    }
    .ledger__fig {
      grid-column: 1;
      grid-row: auto;
      justify-items: start;
      text-align: left;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 12px;
      margin-top: 6px;
    }
    .ledger__fig:empty {
      display: none;
    }
    .ledger__fig .numeral {
      font-size: 2.5rem;
    }
  }
</style>
