---
/**
 * The four kinds of work on the home page. Each row states its outcome first,
 * shows the evidence as a figure, and names where to go to check it.
 *
 * The rows do not share one shape. Teach is a count drawn as dots. Speak leads with the
 * sessions that are on video, and a short list carries the other rooms, each said once
 * with its date. Build is an index of things that exist and can be opened today, with the
 * planned labs on one line marked Next. Measure is a chart drawn to scale, set straight
 * after the claim it proves.
 */
import { getCollection } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import labs from '../../data/labs.json';

const people = 103;
const intensive = 70;
// Until the labs repository is public and its nightly run has passed, the planned labs
// stay one line marked Next and link nowhere.
const labsLive = labs.status === 'live';

// What exists today: the labs on this site, in order. Lab 01 is at the top of this page.
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const built = [
  { no: '01', title: 'Who runs the tool?', href: '#lab-01', where: 'This page', minutes: 1 },
  ...lessons.map((l, i) => ({
    no: String(i + 2).padStart(2, '0'),
    title: l.data.title,
    href: `/teaching/${l.id}`,
    where: l.id === 'connect' ? 'Over MCP' : (undefined as string | undefined),
    minutes: l.data.minutes,
  })),
];
// The Build paragraph says how many of those labs run here, in words, so it never drifts
// from the index under it.
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const builtHere = WORDS[built.length] ?? String(built.length);

// Speak: the rooms other than the intensive, oldest first. Each date is as exact as its
// source allows (the Splunk talk has a year and no month), and each head count is the one
// the site already prints. A month and its year never part across lines.
const rooms = [
  { when: '2022', what: 'Lightning talk at Splunk, “The Limitations of Language”' },
  {
    when: 'Jul 2024',
    what: 'Workshop for 200+ attendees at the All-Team Training Retreat, “Mental Models for Decision Making”',
  },
  { when: 'Since Jul 2026', what: 'Lightning talks at Salesforce' },
];

// Measure: task success on the same 15 tasks, three runs each (The score that lied).
// Teal bars print first, then the pink ones land.
const evals = [
  { model: 'Small model, Claude Haiku 4.5', none: 11, docs: 89, delays: [0.15, 0.6] },
  { model: 'Large model, Claude Sonnet 4.6', none: 84, docs: 100, delays: [0.3, 0.75] },
];
---

<section class="sec" id="work" aria-labelledby="work-h">
  <SectionHead title="Work" id="work-h" />

  <div class="row" id="teach">
    <p class="verb">Teach</p>
    <div>
      <p class="outcome">
        With other instructors, I taught {people} people to build with Claude Code, about {intensive} of them in one
        two-day hands-on intensive.
      </p>
      <a class="more" href="/work/claude-dojo">Read about Claude Dojo</a>
    </div>
    <figure data-print>
      <div class="dots" role="img" aria-label={`${people} dots, one per person. ${intensive} are filled.`}>
        {Array.from({ length: people }, (_, i) => <i class={i < intensive ? 'dot dot--in' : 'dot'} style={`--i:${i}`} />)}
      </div>
      <figcaption>
        One dot per person. Filled dots came through the two-day intensive in July 2026. Open dots are members who did
        not attend it.
      </figcaption>
    </figure>
  </div>

  <div class="row row--speak" id="speak">
    <p class="verb">Speak</p>
    <div>
      <p class="outcome">
        I led sessions on Claude Code at the Claude Dojo intensive in July 2026. Three of them are on video.
      </p>
      <a class="more" href="/teaching/fifteen-terms#walkthrough">Watch the rap walkthrough, 2 minutes 54 seconds</a>
    </div>
    <figure class="venues">
      <ul>
        {
          rooms.map((r) => (
            <li>
              <span class="label">{r.when}</span>
              <span>{r.what}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </div>

  <div class="row row--build" id="build">
    <p class="verb">Build</p>
    <div class="build__say">
      <p class="outcome">
        I build the labs I teach from. {builtHere} of them run on this site, which is also an MCP server an agent can
        connect to. I co-authored the Claude Dojo curriculum: 49 lessons and 46 lesson videos.
      </p>
      <p class="outcome build__bedrock">At Salesforce, I use Claude through Amazon Bedrock.</p>
    </div>
    <div class="build__index">
      <ol class="built" aria-label="Labs you can open now">
        {
          built.map((b) => (
            <li>
              <a href={b.href}>
                <span class="built__no">Lab {b.no}</span>
                <span class="built__title">{b.title}</span>
                <span class="built__time">
                  {b.where ? `${b.where}, ` : ''}
                  {b.minutes} min
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      {
        labsLive ? (
          <p class="next">
            <span class="label">Also</span>
            <a class="more" href="/work/launch-day-labs">
              Six labs for the Claude platform, from a first Messages API call to skills, re-run every night
            </a>
          </p>
        ) : (
          <p class="next">
            <span class="label">Next</span>
            <span>
              Six labs for the Claude platform, from a first Messages API call to skills. Not published yet.
            </span>
          </p>
        )
      }
    </div>
  </div>

  <div class="row row--measure" id="measure">
    <p class="verb">Measure</p>
    <p class="outcome measure__say">
      At Pinecone I first built a score that rated how agent-ready a doc looked. When my manager asked why I trusted it,
      I scrapped it and built an eval that runs real developer tasks.
    </p>
    <figure class="measure__fig" data-print>
      <div
        class="bars"
        role="img"
        aria-label="Task success on 15 tasks, three runs each. Small model: 11 percent with no docs, 89 percent with the curated docs file. Large model: 84 percent with no docs, 100 percent with the docs file."
      >
        <p class="bars__key">
          <span><i class="swatch"></i>No docs</span>
          <span><i class="swatch swatch--docs"></i>Curated docs file</span>
        </p>
        {
          evals.map((e) => (
            <div class="bars__group">
              <p class="label">{e.model}</p>
              <div class="bar" style={`--v:${e.none}%;--d:${e.delays[0]}s`}>
                <span class="bar__fill" />
                <span class="bar__val">{e.none}%</span>
              </div>
              <div class="bar bar--docs" style={`--v:${e.docs}%;--d:${e.delays[1]}s`}>
                <span class="bar__fill" />
                <span class="bar__val">{e.docs}%</span>
              </div>
            </div>
          ))
        }
      </div>
      <figcaption>Same 15 tasks, three runs each. Only the docs changed.</figcaption>
    </figure>
    <a class="more measure__more" href="/work/the-score-that-lied">Read The score that lied</a>
    <div class="council">
      <p>
        At Splunk I founded a council that moved 60+ technical writers onto approved AI tools, with a data policy and a
        person reviewing every AI draft.
      </p>
      <a class="more" href="/work/ix-ai-council">Read about the IX AI Council</a>
    </div>
  </div>
</section>

<style>
  #work {
    padding-top: clamp(56px, 6vw, 88px);
  }
  #work :global(.sec-head) {
    padding-bottom: 12px;
  }
  .row {
    padding: 22px 0 24px;
  }
  .row .outcome {
    font-size: clamp(1.1875rem, 1.65vw, 1.4375rem);
    line-height: 1.32;
  }
  .outcome + .more {
    margin-top: 14px;
  }

  /* Teach: one dot per person, the grid as wide as the figure column. */
  .dots {
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 4px;
  }
  .dot {
    display: block;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .dot--in {
    background: var(--pink);
    border-color: transparent;
    mix-blend-mode: var(--blend);
    transition:
      background-color 0.12s linear calc(0.2s + var(--i, 0) * 11ms),
      border-color 0.12s linear calc(0.2s + var(--i, 0) * 11ms);
  }
  /* Printing on arrival: the room fills one person at a time. */
  :global(.js) [data-print]:not([data-printed]) .dot--in {
    background: transparent;
    border-color: var(--ink);
  }

  /* Speak: the recorded sessions, and beside them the other rooms, each with its date.
     One date column for the whole list. A date too long for it ("Since Jul 2026") takes
     two lines, so the rooms keep the width. */
  .venues ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule);
    display: grid;
    grid-template-columns: fit-content(5.5rem) minmax(0, 1fr);
    column-gap: 16px;
  }
  .venues li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: var(--rule-dash);
    font-size: var(--step-small);
    line-height: 1.35;
  }
  .venues li:last-child {
    border-bottom: 0;
  }

  /* Build: what exists, as an index that opens. The statement takes the middle column,
     the index runs the full width of the two columns under it. */
  .row--build {
    grid-template-areas:
      'verb say say'
      '. index index';
    row-gap: 14px;
  }
  .row--build > .verb {
    grid-area: verb;
  }
  .build__say {
    grid-area: say;
  }
  .build__say .outcome {
    max-width: 52ch;
  }
  /* The Bedrock line is its own statement, at the same size as the one above it. */
  .build__bedrock {
    margin-top: 12px;
  }
  .build__index {
    grid-area: index;
  }
  .built {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
    border-top: var(--rule);
  }
  .built li {
    border-bottom: var(--rule-dash);
  }
  .built a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 1em;
    gap: 2px 10px;
    align-items: baseline;
    padding: 8px 0 9px;
    text-decoration: none;
  }
  .built a::after {
    content: '\2192';
    font-family: var(--font-mono);
    color: var(--ink);
    text-align: right;
  }
  .built__no {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .built__title {
    font-size: 1rem;
    line-height: 1.35;
  }
  .built__time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .built a:hover .built__title,
  .built a:focus-visible .built__title {
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .next {
    display: flex;
    gap: 6px 16px;
    align-items: baseline;
    margin-top: 12px;
    font-size: var(--step-small);
    color: var(--text-soft);
  }

  /* Measure: the Pinecone claim with its chart and its case study, then the Splunk
     council. On a wide screen the chart stands beside both; narrower, it comes straight
     after the claim it proves, so its bars are never read as council data. */
  .row--measure {
    grid-template-areas:
      'verb say  fig'
      '.    more fig'
      '.    next fig';
    grid-template-rows: auto auto 1fr;
    row-gap: 0;
  }
  .row--measure > .verb {
    grid-area: verb;
  }
  .row--measure > .measure__say {
    grid-area: say;
  }
  .row--measure > .measure__fig {
    grid-area: fig;
    align-self: start;
  }
  .row--measure > .measure__more {
    grid-area: more;
    justify-self: start;
    margin-top: 14px;
  }
  .row--measure > .council {
    grid-area: next;
  }
  .council {
    margin-top: 22px;
    padding-top: 14px;
    border-top: var(--rule-dash);
  }
  .council p {
    font-size: var(--step-small);
    line-height: 1.45;
  }
  .council .more {
    margin-top: 14px;
  }

  /* The chart: each bar on a faint track that runs from 0 to 100, its value set at the
     end of the bar, and the two inks named once in the key. */
  .bars {
    display: grid;
    gap: 14px;
  }
  .bars__key {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .swatch {
    display: inline-block;
    width: 13px;
    height: 13px;
    margin-right: 8px;
    vertical-align: -2px;
    background: var(--ink);
  }
  .swatch--docs {
    background: var(--pink);
    mix-blend-mode: var(--blend);
  }
  .bars__group {
    display: grid;
    gap: 8px;
  }
  .bar {
    position: relative;
    height: 24px;
    /* Room past the end of the track for the largest value, 100%. */
    margin-right: 3.5rem;
    border-left: var(--rule);
  }
  /* The rest of the track, from the end of the bar to 100. It is drawn only where the bar
     is not, so a pink bar prints on bare stock and keeps the pink of the key. */
  .bar::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--v);
    right: 0;
    background: var(--ink-tint);
    transition: left 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0.15s);
  }
  .bar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--v);
    background: var(--ink);
    transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0.15s);
  }
  /* Teal is a run with no docs. Pink is the same run with the curated docs file. */
  .bar--docs .bar__fill {
    background: var(--pink);
    mix-blend-mode: var(--blend);
  }
  /* The value rides on the end of its bar as the bar is drawn. */
  .bar__val {
    position: absolute;
    top: 50%;
    left: calc(var(--v) + 8px);
    translate: 0 -50%;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: var(--w-shout);
    font-size: 1.25rem;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition:
      left 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0.15s),
      opacity 0.2s linear var(--d, 0.15s);
  }
  /* Printing on arrival: each bar is drawn to its length, the pink ones last. */
  :global(.js) [data-print]:not([data-printed]) .bar__fill {
    width: 0;
  }
  :global(.js) [data-print]:not([data-printed]) .bar::before {
    left: 0;
  }
  :global(.js) [data-print]:not([data-printed]) .bar__val {
    left: 8px;
    opacity: 0;
  }

  @media (max-width: 900px) {
    .row--speak {
      grid-template-columns: 1fr 1fr;
    }
    .row--build {
      grid-template-areas:
        'verb say'
        'index index';
    }
    /* The chart takes the full width under the Pinecone claim and its link, and the
       council follows it. */
    .row--measure {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
      grid-template-areas:
        'verb say'
        '.    more'
        'fig  fig'
        '.    next';
    }
    .row--measure > .measure__fig {
      margin-top: 22px;
    }
  }
  @media (max-width: 600px) {
    .row {
      padding: 24px 0;
    }
    /* On a phone the four verbs stay display subheads, so the section keeps its structure. */
    .verb {
      font-size: 1.625rem;
    }
    .row--speak {
      grid-template-columns: 1fr;
    }
    .row--build {
      grid-template-areas:
        'verb'
        'say'
        'index';
    }
    .built {
      grid-template-columns: 1fr;
    }
    .built a {
      grid-template-columns: 3.5rem minmax(0, 1fr) 1em;
    }
    .built a::after {
      grid-column: 3;
      grid-row: 1;
    }
    .built__time {
      grid-column: 2;
    }
    .next {
      flex-wrap: wrap;
    }
    .row figure {
      margin-top: 18px;
    }
    /* The Pinecone claim, its chart, its case study, then the council. */
    .row--measure {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'verb'
        'say'
        'fig'
        'more'
        'next';
      row-gap: 0;
    }
    .row--measure > .verb {
      margin-bottom: 10px;
    }
    .row--measure > .measure__fig {
      margin-top: 22px;
    }
    .row--measure > .measure__more {
      margin-top: 18px;
    }
  }
</style>
