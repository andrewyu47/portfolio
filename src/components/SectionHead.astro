---
/**
 * The heading row of a page section: a big condensed title in the label column,
 * one plain sentence beside it, and a solid rule underneath.
 */
interface Props {
  title: string;
  id?: string;
  as?: 'h1' | 'h2';
}
const { title, id, as: Tag = 'h2' } = Astro.props;
---

<div class="sec-head">
  <Tag id={id}>{title}</Tag>
  <p><slot /></p>
</div>
